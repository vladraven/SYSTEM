# MacroRisk 1.7.1-FINAL
# File: .env.example
# Purpose: Environment template for local/staging/production deployment.
#
# Rules:
# - Do not commit real secrets.
# - All timestamps are normalized to UTC before persistence.
# - Laravel variables are intentionally not used.
# - Runtime LLM is not used for production decisions or narratives.

MACRORISK_APP_ENV=production
MACRORISK_APP_DEBUG=false
MACRORISK_APP_TIMEZONE=UTC
MACRORISK_APP_BASE_URL=https://demo.westmangroupwebtest.com

MACRORISK_DB_HOST=localhost
MACRORISK_DB_NAME=webtest_economic_digital_twin
MACRORISK_DB_USER=webtest_macrorisk
MACRORISK_DB_PASSWORD=

MACRORISK_SESSION_NAME=macrorisk_session
MACRORISK_SESSION_LIFETIME_SECONDS=7200

MACRORISK_ADMIN_BOOTSTRAP_ALLOWED=true

MACRORISK_DEFAULT_LOCALE=en-CA
MACRORISK_SECONDARY_LOCALE=fr-CA

MACRORISK_LOG_PATH=storage/logs/macrorisk.log
MACRORISK_AUDIT_EXPORT_PATH=storage/exports/audit

MACRORISK_SETUP_LOCK_PATH=storage/setup.lock
MACRORISK_FILE_LOCK_PATH=storage/locks

MACRORISK_HTTP_TIMEOUT_SECONDS=30
MACRORISK_HTTP_USER_AGENT=MacroRisk/0.0.1-DEV

MACRORISK_PRODUCTION_VALIDATION_MAX_AGE_DAYS=30
MACRORISK_BOOTSTRAP_MIN_VALID_SERIES=5
MACRORISK_BOOTSTRAP_MIN_PUBLIC_OPEN_SERIES=5
MACRORISK_BOOTSTRAP_MIN_AVAILABLE_INDICATORS=3

MACRORISK_BACKTEST_RATE_LIMIT_PER_HOUR=5